# Data stores. These are large binary artifacts, not source. CLAUDE.md already
# describes financials.db as git-ignored; this file is what actually makes that
# true. Committing them would write several gigabytes into history permanently.
financials.db
financials.db.backup-*
backend/financials.db
backend/market_data.db
rag/vault.db
rag/glossary.db

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node / build output
node_modules/
frontend/dist/
frontend/.vite/

# Local env and secrets. .env.production is committed on purpose (it holds only
# public URLs); .env.local carries the dev Convex deployment and stays local.
.env
.env.local

# Logs and scratch
*.log
tmp/
output/
data_cache/

# Hand-supplied source workbooks (backend/marketdata/aaii_allocation.py). The AAII
# Asset Allocation Survey is member content, so the workbook is dropped in locally
# and never redistributed through this repo. The metric degrades to "chart data
# source pending" when it is absent.
data_manual/

# More database artifacts. The 2026-07-13 remediation created these and they are
# each ~630MB. They must never enter history: a single careless `git add -A` put
# 1.26GB of them into a commit and inflated the pack to 5GB.
financials.db.pre-swap-*
financials_remediation.db
*.db
!frontend/**/*.db
