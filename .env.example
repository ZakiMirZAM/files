# Backend (FastAPI) environment — copy to a host-level .env or set in the process
# environment. Never commit real values.

# FRED (St. Louis Fed) API key — free at https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, FRED-backed economic series render empty (the app still runs).
FRED_API_KEY=

# Production hardening (Phase 2)
ENV=production
# Comma-separated allowed browser origins for CORS. Leave unset in local dev.
ALLOWED_ORIGINS=https://intrinsicfined.org,https://www.intrinsicfined.org
# Shared secret guarding admin routes (/api/cache/clear, /api/daily-update).
# Generate a long random value; requests must send it as the X-Admin-Token header.
ADMIN_TOKEN=

# Optional: override the fundamentals DB path (defaults to repo-root financials.db)
# FINANCIALS_DB=

# Optional scheduler toggles
# DISABLE_MARKETDATA_REFRESH=1
# DISABLE_WEEKLY_PE=1
