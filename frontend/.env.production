# Production build-time env (Vite bakes VITE_* into the bundle at `vite build`).
# Used by Cloudflare Pages CI (where .env.local is absent because it's gitignored).
#
# NOTE: for a LOCAL production build, .env.local overrides this file — use
# build-prod.ps1 (which sets these inline) or set them in the shell.

VITE_API_BASE=https://api.intrinsicfined.org
VITE_AI_BASE=https://ai.intrinsicfined.org

# Set this to the PRODUCTION Convex deployment URL from `npx convex deploy`
# (NOT the dev dev:acrobatic-ibex-530 one). Set it here after deploying, or in
# the Cloudflare Pages dashboard env vars (dashboard wins over this file).
# VITE_CONVEX_URL=https://<your-prod-deployment>.convex.cloud
